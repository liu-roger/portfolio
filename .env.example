# Canonical origin — used for metadata, Open Graph tags and the sitemap.
# Include the protocol, no trailing slash.
#
# Optional. If unset, the site falls back to Vercel's own deployment domain
# (NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL), then to http://localhost:3000.
# Leave it out entirely rather than setting it to an empty value.
NEXT_PUBLIC_SITE_URL=https://example.com
